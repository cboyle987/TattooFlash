@page "/management"

<MudContainer>

    
    @if (IsLoading)
    {
        foreach (var i in Enumerable.Range(0, 4))
        {
            <SkeletonDesignManagementItem />
        }
    }
    else
    {
        <MudPaper Class="d-flex justify-center pa-6 my-4">
            <MudButton Class="px-6 py-3" Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Add">Add New Design</MudButton>
        </MudPaper>
        foreach (var design in Designs)
        {
            <DesignManagementItem @key="design.Id" Design="design"
                                  OnDesignDeleted="RemoveDesign"
                                  OnAvailabilityChanged="UpdateAvailability" />
        }
    }
</MudContainer>
