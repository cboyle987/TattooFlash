@page "/management"

<MudContainer>

    
    @if (IsLoading)
    {
        foreach (var i in Enumerable.Range(0, 4))
        {
            <SkeletonDesignManagementItem />
        }
    }
    else
    {
        <MudPaper>
            <MudGrid Spacing="3">
                <MudItem xs="12" md="6" Class="my-5">
                    <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Add">Add New Design</MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>
        foreach (var design in Designs)
        {
            <DesignManagementItem Design="design" OnDesignDeleted="LoadDesigns" />
        }
    }
</MudContainer>
