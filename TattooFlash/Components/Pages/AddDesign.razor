@page "/management/add-design"
@attribute [Authorize]


<MudContainer>
    <MudPaper>
        <MudGrid>
            <MudItem xs="12" class="d-flex justify-center">
                <MudText Typo="Typo.h3">Add New Design</MudText>
            </MudItem>
        </MudGrid>
        @if (!string.IsNullOrEmpty(_saveError))
        {
            <MudAlert Severity="Severity.Error">@_saveError</MudAlert>
        }
        
        <DesignInput Design="NewDesign" OnValidSubmit="CreateDesign" />
    </MudPaper>

</MudContainer>