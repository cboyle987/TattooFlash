@using TattooFlash.Models
@using TattooFlash.Services
<MudPaper Class="pa-4 my-4">
    <MudGrid Spacing="3" Class="align-center">
        <MudItem xs="12" md="4" Class="d-flex justify-center justify-md-start">
            <MudImage ObjectFit="@ObjectFit.ScaleDown" Height="100" Width="150" Src="@ImageUrl" Alt="@Design.Name" Elevation="25" Class="rounded-lg" />
        </MudItem>
        <MudItem xs="12" md="4" Class="d-flex justify-center justify-md-start">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudText Typo="Typo.h5" Class="text-center text-md-start">@(Design.Name)</MudText>
                <MudTooltip Text="@(Design.IsAvailable ? "Available" : "Not available")">
                    <MudIcon Icon="@(Design.IsAvailable ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                             Color="@(Design.IsAvailable ? Color.Success : Color.Default)"
                             Style="@(Design.IsAvailable ? null : "color: var(--mud-palette-text-secondary);")"
                             aria-label="@(Design.IsAvailable ? "Available" : "Not available")" />
                </MudTooltip>
            </MudStack>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudStack Spacing="2" AlignItems="AlignItems.Center">
                <MudButton Disabled="IsBusy" Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" OnClick="EditDesign">
                    Edit Design
                </MudButton>
                <MudButton Disabled="IsBusy" Size="Size.Small" Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteDesign">
                    Delete Design
                </MudButton>
                <MudButton Disabled="IsBusy" Size="Size.Small" Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Visibility" OnClick="ToggleAvailability">
                    Toggle Availability
                </MudButton>
            </MudStack>
        </MudItem>
    </MudGrid>
</MudPaper>
@code {
    [Parameter]
    public DesignModel Design { get; set; } = default!;
    [Parameter]
    public EventCallback<Guid> OnDesignDeleted { get; set; }
    [Parameter]
    public EventCallback<Guid> OnAvailabilityChanged { get; set; }
    [Inject]
    public IDesignService DesignService { get; set; } = default!;
    [Inject]
    public IDialogService DialogService { get; set; } = default!;
    [Inject]
    public IImageService imageUrlService { get; set; } = default!;
    [Inject]
    public ISnackbar Snackbar { get; set; } = default!;

    private bool IsBusy { get; set; }
    [Inject]
    public NavigationManager NavigationManager { get; set; } = default!;

    private string ImageUrl => imageUrlService.GetImageUrl(Design.ImageName);

    private void EditDesign()
    {
        NavigationManager.NavigateTo($"/management/edit-design/{Design.Id.ToString()}");
    }

    private async Task DeleteDesign()
    {
        if (IsBusy)
            return;

        IsBusy = true;
        try
        {
            var dialogParameters = new DialogParameters
            {
                { "Design", Design }
            };
            var confirmDialog = await DialogService.ShowAsync<DeleteConfirmationDialog>("Confirm Delete", dialogParameters);
            var confirmation = await confirmDialog.Result;

            if (confirmation is { Canceled: false })
            {
                var result = await DesignService.DeleteDesignAsync(Design.Id);
                await OnDesignDeleted.InvokeAsync(Design.Id);
                if (!result)
                    Snackbar.Add("This design was already deleted.", Severity.Info);
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Could not delete the design. Please try again.", Severity.Error);
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task ToggleAvailability()
    {
        if (IsBusy)
            return;

        IsBusy = true;
        try
        {
            await DesignService.ToggleAvailabilityAsync(Design.Id);
            await OnAvailabilityChanged.InvokeAsync(Design.Id);
        }
        catch (Exception)
        {
            Snackbar.Add("Could not change availability. Please try again.", Severity.Error);
        }
        finally
        {
            IsBusy = false;
        }
    }
}
