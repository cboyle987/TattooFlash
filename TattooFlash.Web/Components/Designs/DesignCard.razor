<MudCard Class="d-flex flex-column" Style="width: 100%; overflow: hidden;">
    <div style="position: relative; aspect-ratio: 1; background-color: var(--mud-palette-background-grey);">
        <img src="@ImageUrl" alt="@Design.Name" loading="lazy"
             style="display: block; width: 100%; height: 100%; object-fit: contain; position: absolute;" />
        @if (!Design.IsAvailable)
        {
            <MudOverlay Visible="true" Absolute="true" LockScroll="false"
                        Style="background-color: rgba(128, 128, 128, 0.25);">
                <MudChip T="string" Variant="Variant.Filled" Color="Color.Dark">Not available</MudChip>
            </MudOverlay>
        }
    </div>
    <MudCardContent Class="flex-grow-1">
        
        <MudText Typo="Typo.h6" Style="overflow-wrap: anywhere;">@Design.Name</MudText>
        <MudText Typo="Typo.subtitle1" Class="mt-1" Style="font-weight: 600;">£@Design.Price</MudText>
        @foreach (var tag in Design.Tags)
        {
            <MudChip Size="Size.Small" T="string" Variant="Variant.Outlined" Color="Color.Primary" Class="me-1 mb-1">@tag.DisplayName</MudChip>
        }
    </MudCardContent>
    <MudCardActions>
        <MudButton FullWidth="true" Disabled=@(!Design.IsAvailable) Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenBookingDialog">Details &amp; booking</MudButton>
    </MudCardActions>
    
</MudCard>
