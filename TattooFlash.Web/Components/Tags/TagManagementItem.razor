<MudPaper Class="pa-4 my-4">
    <MudGrid Spacing="3" Class="align-center">
        <MudItem xs="12" md="4" Class="d-flex justify-center justify-md-start">
            <MudText Typo="Typo.h5" Class="text-center text-md-start">@(Tag.DisplayName)</MudText>
        </MudItem>
        <MudItem xs="12" md="8">
            <MudStack Spacing="2" AlignItems="AlignItems.Center">
                <MudButton Disabled="IsBusy" Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" OnClick="EditTag">
                    Edit Tag
                </MudButton>
                <MudButton Disabled="IsBusy" Size="Size.Small" Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteTag">
                    Delete Tag
                </MudButton>
            </MudStack>
        </MudItem>
    </MudGrid>
</MudPaper>
