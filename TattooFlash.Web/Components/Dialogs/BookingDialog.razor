<MudDialog ActionsClass="justify-center" Style="width: calc(100% - 24px); max-width: 600px; height: min(800px, calc(100dvh - 24px)); max-height: calc(100dvh - 24px); margin: 12px;" ContentClass="pa-4 d-flex flex-column">
    <TitleContent>
        <MudText Typo="Typo.h4">@Design.Name</MudText>
    </TitleContent>
    <DialogContent>
        <div class="d-flex justify-center">
            <MudImage Src="@ImageUrl" Alt="@Design.Name" Class="rounded-lg" Style="display: block" Width="450" Height="450" ObjectFit="ObjectFit.ScaleDown" />
        </div>

        <MudText Typo="Typo.h5" Class="mt-2 flex-shrink-0">Price: £@Design.Price</MudText>
        <MudText Typo="Typo.body2" Class="mt-1 flex-shrink-0">Click below to DM me on instagam. Please include a screenshot of this design in your message so that I know which design you're interested in.</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" StartIcon="@Icons.Custom.Brands.Instagram" Style="background: linear-gradient(45deg, #833ab4, #c13584, #e1306c);
            color: white;" href="@InstagramLink" Target="_blank">
            Book Now
        </MudButton>
    </DialogActions>
</MudDialog>