@page "/management/design/add"
@using TattooFlash.Web.Components.Designs
@attribute [Authorize]


<MudContainer>
    <MudPaper>

        @if (_isLoading)
        {
            <MudProgressCircular Indeterminate="true"></MudProgressCircular>
        }
        else
        {

            @if (!string.IsNullOrEmpty(_loadError))
            {
                <MudAlert class="mx-5" Severity="Severity.Error">@_loadError</MudAlert>
            } else
            {
                <MudGrid>
                    <MudItem xs="12" class="d-flex justify-center">
                        <MudText Typo="Typo.h3">Add New Design</MudText>
                    </MudItem>
                </MudGrid>
                @if (!string.IsNullOrEmpty(_saveError))
                {
                    <MudAlert Severity="Severity.Error">@_saveError</MudAlert>
                }

                <DesignInput Design="NewDesign" OnValidSubmit="CreateDesign" AvailableTags="_availableTags" />
            }
            
        }

    </MudPaper>

</MudContainer>
